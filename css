.marketing-landing {
    padding: 6rem 5%;
    background: var(--text);
    color: white;
    text-align: center;
}

.signup-container {
    max-width: 600px;
    margin: 0 auto;
}

#leadForm {
    display: flex;
    gap: 0;
    margin-top: 2rem;
    justify-content: center;
}

#userEmail {
    padding: 1rem;
    width: 60%;
    border: none;
}

.btn-submit {
    padding: 1rem 2rem;
    background: #333;
    color: white;
    border: 1px solid #555;
    cursor: pointer;
}

.hidden { display: none; margin-top: 1rem; color: #4bb543; }
